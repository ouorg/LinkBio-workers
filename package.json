{
  "name": "linkbio-workers",
  "version": "1.0.0",
  "description": "A lightweight, configurable personal Bio / Digital Card platform on Cloudflare Workers",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "build": "npm run sync:css && wrangler deploy --dry-run --outdir=dist",
    "deploy": "npm run sync:css && wrangler deploy",
    "typecheck": "tsc --noEmit",
    "sync:css": "node scripts/sync-css.mjs",
    "cf-typegen": "wrangler types",
    "predev": "node scripts/sync-css.mjs"
  },
  "dependencies": {
    "hono": "^4.7.10"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250525.0",
    "typescript": "^5.8.3",
    "wrangler": "^4.16.0"
  },
  "overrides": {
    "@cloudflare/workers-types": "$@cloudflare/workers-types"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "MIT"
}
